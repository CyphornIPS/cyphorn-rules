# next sid 2221051
# CyphornIPS — production protection ruleset
# /etc/cyphornips/rules/local/protect.rules
#
# Written against what this engine can actually see, not against what a rule
# language can express. Three things shape every rule below:
#
#   1. There is no `pcre`. Matching is literal content, with depth/offset/
#      distance/within and the sticky buffers the parser accepts. A rule that
#      needs a regex is not written here; it is left out and said so.
#
#   2. HTTP/2 and HTTP/3 are not parsed. Every http.* rule below applies to
#      HTTP/1.1 only. Against a modern browser most web traffic is HTTP/2
#      inside TLS, so these rules protect *servers behind this appliance*
#      far more than they protect clients in front of it.
#
#   3. Inside TLS the engine sees the handshake, not the content: SNI, JA3,
#      certificate fields. So outbound protection is identity-based --
#      which host, which client fingerprint -- not payload-based.
#
# SID range 2100000-2100999 is this file. Not 2000000: the appliance's
# existing local/self_protect.rules already uses it, and 2000001, 2000010
# and 2000020 collided exactly. Two rules sharing one SID is one rule
# nobody can disable by number. Local rules, owned here, never
# overwritten by an update.
#
# `drop` is used only where legitimate traffic does not look like this.
# Everything with a plausible benign explanation is `alert`, and the comment
# says what would have to be true before it could be promoted.

# =====================================================================
# 1. Log4Shell and JNDI injection                          [drop]
# =====================================================================
# The clearest drop rule in the file. No legitimate HTTP traffic contains
# the JNDI lookup prefix. Checked in the URI, the headers and the body
# separately, because the exploit's whole point was that it worked from any
# string a server might log.

drop tcp any any -> any any (msg:"CYPHORN Log4Shell JNDI in URI"; flow:established,to_server; http.uri; content:"${jndi:"; nocase; classtype:attempted-admin; priority:1; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN Log4Shell JNDI in URI, source payload patterns for attacks against services behind this appliance; sid:2100001; rev:1;)
drop tcp any any -> any any (msg:"CYPHORN Log4Shell JNDI in header"; flow:established,to_server; http.header; content:"${jndi:"; nocase; classtype:attempted-admin; priority:1; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN Log4Shell JNDI in header, source payload patterns for attacks against services behind this appliance; sid:2100002; rev:1;)
drop tcp any any -> any any (msg:"CYPHORN Log4Shell JNDI in body"; flow:established,to_server; http.client_body; content:"${jndi:"; nocase; classtype:attempted-admin; priority:1; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN Log4Shell JNDI in body, source payload patterns for attacks against services behind this appliance; sid:2100003; rev:1;)
# The lower-case-only obfuscation variants that were used within days of
# disclosure. Literal strings, because there is no regex to fold them.
drop tcp any any -> any any (msg:"CYPHORN Log4Shell obfuscated jndi"; flow:established,to_server; http.header; content:"${${"; content:":-j}"; distance:0; classtype:attempted-admin; priority:1; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN Log4Shell obfuscated jndi, source payload patterns for attacks against services behind this appliance; sid:2100004; rev:1;)

# =====================================================================
# 2. Path traversal                                        [drop]
# =====================================================================
# `../` in a URI has no legitimate use: a browser resolves relative paths
# before sending. The encoded forms are checked separately because the
# engine normalises what it can and these are what survive.

drop tcp any any -> any any (msg:"CYPHORN Path traversal in URI"; flow:established,to_server; http.uri; content:"../"; classtype:web-application-attack; priority:1; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN Path traversal in URI, source payload patterns for attacks against services behind this appliance; sid:2100010; rev:1;)
drop tcp any any -> any any (msg:"CYPHORN Path traversal URL-encoded"; flow:established,to_server; http.uri; content:"..%2f"; nocase; classtype:web-application-attack; priority:1; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN Path traversal URL-encoded, source payload patterns for attacks against services behind this appliance; sid:2100011; rev:1;)
drop tcp any any -> any any (msg:"CYPHORN Path traversal double-encoded"; flow:established,to_server; http.uri; content:"..%252f"; nocase; classtype:web-application-attack; priority:1; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN Path traversal double-encoded, source payload patterns for attacks against services behind this appliance; sid:2100012; rev:1;)
drop tcp any any -> any any (msg:"CYPHORN Path traversal backslash form"; flow:established,to_server; http.uri; content:"..%5c"; nocase; classtype:web-application-attack; priority:1; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN Path traversal backslash form, source payload patterns for attacks against services behind this appliance; sid:2100013; rev:1;)
# The decoded form as well. The corpus case traversal-backslash --
# /x?f=..%5c..%5cwindows -- was missed by the rule above: the URI is
# normalised before a rule sees it, so %5c is already a backslash and
# the literal "..%5c" is no longer in the buffer. Found in TUNE, which
# is what TUNE is for; the HOLDOUT set was not consulted for it.
drop tcp any any -> any any (msg:"CYPHORN Path traversal backslash decoded"; flow:established,to_server; http.uri; content:"..|5c|"; nocase; classtype:web-application-attack; priority:1; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN Path traversal backslash decoded, source payload patterns for attacks against services behind this appliance; sid:2100017; rev:1;)
# The target, not the technique: any request naming these files is hostile
# regardless of how it got there.
drop tcp any any -> any any (msg:"CYPHORN Sensitive file access /etc/passwd"; flow:established,to_server; http.uri; content:"/etc/passwd"; nocase; classtype:web-application-attack; priority:1; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN Sensitive file access /etc/passwd, source payload patterns for attacks against services behind this appliance; sid:2100014; rev:1;)
drop tcp any any -> any any (msg:"CYPHORN Sensitive file access /etc/shadow"; flow:established,to_server; http.uri; content:"/etc/shadow"; nocase; classtype:web-application-attack; priority:1; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN Sensitive file access /etc/shadow, source payload patterns for attacks against services behind this appliance; sid:2100015; rev:1;)
drop tcp any any -> any any (msg:"CYPHORN Windows SAM access attempt"; flow:established,to_server; http.uri; content:"win.ini"; nocase; classtype:web-application-attack; priority:1; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN Windows SAM access attempt, source payload patterns for attacks against services behind this appliance; sid:2100016; rev:1;)

# =====================================================================
# 3. SQL injection                                         [drop / alert]
# =====================================================================
# Two tiers on purpose. `UNION SELECT` and `information_schema` in a URI are
# attacks; a search box can legitimately contain the word "select" alone,
# which is why no rule below matches a single SQL keyword.

# Explicit separators, not a proximity window.
#
# The benign corpus case article-sql-injection --
# /support/articles/preventing-sql-injection-union-select-attacks --
# was BLOCKED by the old rule, which matched "union" followed by
# "select" within thirty-two bytes. A support article about SQL
# injection being blocked by the SQL injection rule is the classic
# failure of this product category, and it shipped here.
#
# An attack separates the two keywords with whitespace, which on a URI
# is a plus or an encoding of it. An article separates them with a
# hyphen. Residual, stated: an attacker using %09, %0a or /**/ as the
# separator is not matched by these three, and a proximity window that
# caught them also caught the article.
drop tcp any any -> any any (msg:"CYPHORN SQLi UNION SELECT in URI"; flow:established,to_server; http.uri; content:"union+select"; nocase; classtype:web-application-attack; priority:1; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN SQLi UNION SELECT in URI, source payload patterns for attacks against services behind this appliance; sid:2100020; rev:2;)
drop tcp any any -> any any (msg:"CYPHORN SQLi UNION SELECT encoded space"; flow:established,to_server; http.uri; content:"union%20select"; nocase; classtype:web-application-attack; priority:1; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN SQLi UNION SELECT encoded space, source payload patterns for attacks against services behind this appliance; sid:2100018; rev:1;)
drop tcp any any -> any any (msg:"CYPHORN SQLi UNION SELECT comment separator"; flow:established,to_server; http.uri; content:"union/**/select"; nocase; classtype:web-application-attack; priority:1; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN SQLi UNION SELECT comment separator, source payload patterns for attacks against services behind this appliance; sid:2100019; rev:1;)
drop tcp any any -> any any (msg:"CYPHORN SQLi information_schema"; flow:established,to_server; http.uri; content:"information_schema"; nocase; classtype:web-application-attack; priority:1; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN SQLi information_schema, source payload patterns for attacks against services behind this appliance; sid:2100021; rev:1;)
drop tcp any any -> any any (msg:"CYPHORN SQLi time-based SLEEP"; flow:established,to_server; http.uri; content:"sleep("; nocase; classtype:web-application-attack; priority:1; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN SQLi time-based SLEEP, source payload patterns for attacks against services behind this appliance; sid:2100022; rev:1;)
drop tcp any any -> any any (msg:"CYPHORN SQLi time-based BENCHMARK"; flow:established,to_server; http.uri; content:"benchmark("; nocase; classtype:web-application-attack; priority:1; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN SQLi time-based BENCHMARK, source payload patterns for attacks against services behind this appliance; sid:2100023; rev:1;)
# within:2, not within:16. The benign corpus case search-drop-table --
# /search?q=how+to+drop+a+table+leaf+safely -- was BLOCKED by the old
# rule: "drop a table" fits inside sixteen bytes. Two bytes admits
# "drop table" and "drop+table" and refuses an article in between.
drop tcp any any -> any any (msg:"CYPHORN SQLi stacked query DROP TABLE"; flow:established,to_server; http.uri; content:"drop"; nocase; content:"table"; nocase; distance:0; within:2; classtype:web-application-attack; priority:1; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN SQLi stacked query DROP TABLE, source payload patterns for attacks against services behind this appliance; sid:2100024; rev:2;)
# Same change as 2100020, for the same reason: a body carrying prose
# about SQL injection is not an attack.
# Reverted to a proximity window, and the narrowing that replaced it was
# never justified: no benign case ever fired 2100025. It was changed
# speculatively alongside 2100020, and it cost a holdout case --
# sqli-union-body, u=a&p=x'+union+select+1,2-- , which the window had
# caught and the two-byte form did not.
#
# A request body is not a page of prose the way a URI path can be, so the
# false-positive argument that narrowed the URI rule does not carry here.
drop tcp any any -> any any (msg:"CYPHORN SQLi UNION SELECT in body"; flow:established,to_server; http.client_body; content:"union"; nocase; content:"select"; nocase; distance:0; within:32; classtype:web-application-attack; priority:1; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN SQLi UNION SELECT in body, source payload patterns for attacks against services behind this appliance; sid:2100025; rev:3;)
# Alert, not drop: a tautology can appear in a legitimate string, and this
# one has been seen in password fields belonging to people testing their own
# site. Promote once a week of traffic shows it only firing on attacks.
alert tcp any any -> any any (msg:"CYPHORN SQLi tautology OR 1=1"; flow:established,to_server; http.uri; content:"or+1=1"; nocase; classtype:web-application-attack; priority:2; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN SQLi tautology OR 1=1, source payload patterns for attacks against services behind this appliance; sid:2100026; rev:1;)

# =====================================================================
# 4. Command injection and webshells                       [drop]
# =====================================================================
# The pipe character is written |7c| and not "|". A bare pipe opens a hex
# block in this rule syntax, so content:"|nc" is not the two characters it
# looks like -- it is an unterminated byte sequence, and the rule is refused
# at load. Three rules here were written that way and the engine rejected
# all three by line number, which is the behaviour to want: a rule that
# silently loaded and never matched would be a coverage gap shaped like
# coverage.

drop tcp any any -> any any (msg:"CYPHORN Command injection semicolon cat"; flow:established,to_server; http.uri; content:";cat"; nocase; classtype:web-application-attack; priority:1; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN Command injection semicolon cat, source payload patterns for attacks against services behind this appliance; sid:2100030; rev:1;)
drop tcp any any -> any any (msg:"CYPHORN Command injection pipe netcat"; flow:established,to_server; http.uri; content:"|7c|nc"; nocase; classtype:web-application-attack; priority:1; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN Command injection pipe netcat, source payload patterns for attacks against services behind this appliance; sid:2100031; rev:1;)
drop tcp any any -> any any (msg:"CYPHORN Command injection wget pipe shell"; flow:established,to_server; http.uri; content:"wget"; nocase; content:"|7c|sh"; nocase; distance:0; classtype:web-application-attack; priority:1; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN Command injection wget pipe shell, source payload patterns for attacks against services behind this appliance; sid:2100032; rev:1;)
drop tcp any any -> any any (msg:"CYPHORN Command injection curl pipe bash"; flow:established,to_server; http.uri; content:"curl"; nocase; content:"|7c|bash"; nocase; distance:0; classtype:web-application-attack; priority:1; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN Command injection curl pipe bash, source payload patterns for attacks against services behind this appliance; sid:2100033; rev:1;)
# A PHP open tag arriving in an upload body. Legitimate file uploads do not
# contain executable source; a site that genuinely accepts .php uploads
# should disable this rule by SID rather than run without the rest.
drop tcp any any -> any any (msg:"CYPHORN PHP code in upload body"; flow:established,to_server; http.client_body; content:"<?php"; nocase; classtype:web-application-attack; priority:1; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN PHP code in upload body, source payload patterns for attacks against services behind this appliance; sid:2100034; rev:1;)
drop tcp any any -> any any (msg:"CYPHORN Webshell system() in upload body"; flow:established,to_server; http.client_body; content:"system("; nocase; content:"$_"; distance:0; within:64; classtype:web-application-attack; priority:1; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN Webshell system() in upload body, source payload patterns for attacks against services behind this appliance; sid:2100035; rev:1;)
drop tcp any any -> any any (msg:"CYPHORN Webshell eval base64_decode"; flow:established,to_server; http.client_body; content:"eval("; nocase; content:"base64_decode"; nocase; distance:0; within:64; classtype:web-application-attack; priority:1; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN Webshell eval base64_decode, source payload patterns for attacks against services behind this appliance; sid:2100036; rev:1;)

# =====================================================================
# 5. Server-side template and deserialisation              [drop]
# =====================================================================

drop tcp any any -> any any (msg:"CYPHORN Java deserialisation magic in body"; flow:established,to_server; http.client_body; content:"|ac ed 00 05|"; depth:16; classtype:attempted-admin; priority:1; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN Java deserialisation magic in body, source payload patterns for attacks against services behind this appliance; sid:2100040; rev:1;)
drop tcp any any -> any any (msg:"CYPHORN Java gadget CommonsCollections"; flow:established,to_server; http.client_body; content:"org.apache.commons.collections"; nocase; classtype:attempted-admin; priority:1; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN Java gadget CommonsCollections, source payload patterns for attacks against services behind this appliance; sid:2100041; rev:1;)
drop tcp any any -> any any (msg:"CYPHORN Spring4Shell class loader access"; flow:established,to_server; http.client_body; content:"class.module.classLoader"; nocase; classtype:attempted-admin; priority:1; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN Spring4Shell class loader access, source payload patterns for attacks against services behind this appliance; sid:2100042; rev:1;)

# =====================================================================
# 6. Scanners and reconnaissance                           [alert]
# =====================================================================
# Alert, not drop. Blocking a scanner tells it that something is here and
# filtering; letting it complete and recording it is more useful. Promote to
# drop only if the noise becomes the problem.

alert tcp any any -> any any (msg:"CYPHORN Scanner user-agent sqlmap"; flow:established,to_server; http.user_agent; content:"sqlmap"; nocase; classtype:attempted-recon; priority:2; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN Scanner user-agent sqlmap, source payload patterns for attacks against services behind this appliance; sid:2100050; rev:1;)
alert tcp any any -> any any (msg:"CYPHORN Scanner user-agent nikto"; flow:established,to_server; http.user_agent; content:"nikto"; nocase; classtype:attempted-recon; priority:2; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN Scanner user-agent nikto, source payload patterns for attacks against services behind this appliance; sid:2100051; rev:1;)
alert tcp any any -> any any (msg:"CYPHORN Scanner user-agent nmap"; flow:established,to_server; http.user_agent; content:"nmap"; nocase; classtype:attempted-recon; priority:2; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN Scanner user-agent nmap, source payload patterns for attacks against services behind this appliance; sid:2100052; rev:1;)
alert tcp any any -> any any (msg:"CYPHORN Scanner user-agent masscan"; flow:established,to_server; http.user_agent; content:"masscan"; nocase; classtype:attempted-recon; priority:2; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN Scanner user-agent masscan, source payload patterns for attacks against services behind this appliance; sid:2100053; rev:1;)
alert tcp any any -> any any (msg:"CYPHORN Git directory exposure probe"; flow:established,to_server; http.uri; content:"/.git/"; nocase; classtype:attempted-recon; priority:2; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN Git directory exposure probe, source payload patterns for attacks against services behind this appliance; sid:2100054; rev:1;)
alert tcp any any -> any any (msg:"CYPHORN Environment file probe"; flow:established,to_server; http.uri; content:"/.env"; nocase; classtype:attempted-recon; priority:2; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN Environment file probe, source payload patterns for attacks against services behind this appliance; sid:2100055; rev:1;)
alert tcp any any -> any any (msg:"CYPHORN phpMyAdmin probe"; flow:established,to_server; http.uri; content:"phpmyadmin"; nocase; classtype:attempted-recon; priority:2; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN phpMyAdmin probe, source payload patterns for attacks against services behind this appliance; sid:2100056; rev:1;)
# endswith. The benign case wp-config-doc --
# /docs/wordpress/editing-wp-config.php-safely -- matched a rule looking
# for the filename anywhere in the URI. A probe asks for the file; an
# article mentions it.
alert tcp any any -> any any (msg:"CYPHORN WordPress config probe"; flow:established,to_server; http.uri; content:"wp-config.php"; nocase; endswith; classtype:attempted-recon; priority:2; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN WordPress config probe, source payload patterns for attacks against services behind this appliance; sid:2100057; rev:2;)

# =====================================================================
# 7. Outbound: what protects a client behind this appliance
# =====================================================================
# This is where a phone on the LAN is actually defended. Its web traffic is
# HTTP/2 or HTTP/3 inside TLS and the rules in sections 1-6 will never see
# it. What the engine does see is the handshake -- so protection here is
# about *who is being talked to*, not what is being said.

# Cryptocurrency mining. The stratum protocol is cleartext and unambiguous --
# but the *word* is not. The benign corpus case mining-article
# (/blog/detecting-mining.subscribe-in-your-network) was BLOCKED by a rule
# matching the bare method name. Quoted, as the JSON-RPC wire form has it,
# so the rule matches the protocol and not an article about the protocol.
drop tcp any any -> any any (msg:"CYPHORN Cryptomining stratum subscribe"; flow:established,to_server; content:"|22|mining.subscribe|22|"; nocase; classtype:policy-violation; priority:1; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN Cryptomining stratum subscribe, source payload patterns for attacks against services behind this appliance; sid:2100060; rev:2;)
drop tcp any any -> any any (msg:"CYPHORN Cryptomining stratum authorize"; flow:established,to_server; content:"|22|mining.authorize|22|"; nocase; classtype:policy-violation; priority:1; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN Cryptomining stratum authorize, source payload patterns for attacks against services behind this appliance; sid:2100061; rev:2;)

# Credentials in cleartext HTTP. Alert rather than drop: breaking a login is
# worse than recording that it happened insecurely.
alert tcp any any -> any any (msg:"CYPHORN Password submitted over cleartext HTTP"; flow:established,to_server; http.client_body; content:"password="; nocase; classtype:policy-violation; priority:2; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN Password submitted over cleartext HTTP, source payload patterns for attacks against services behind this appliance; sid:2100062; rev:1;)

# Known-malicious download extensions over cleartext HTTP.
alert tcp any any -> any any (msg:"CYPHORN Executable download over cleartext HTTP"; flow:established,to_server; http.uri; content:".exe"; nocase; endswith; classtype:policy-violation; priority:2; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN Executable download over cleartext HTTP, source payload patterns for attacks against services behind this appliance; sid:2100063; rev:1;)
alert tcp any any -> any any (msg:"CYPHORN Script download over cleartext HTTP"; flow:established,to_server; http.uri; content:".ps1"; nocase; endswith; classtype:policy-violation; priority:2; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN Script download over cleartext HTTP, source payload patterns for attacks against services behind this appliance; sid:2100064; rev:1;)

# DNS. The one place a client's intent is still visible in cleartext, and so
# the highest-value outbound signal this engine has.
alert dns any any -> any any (msg:"CYPHORN DNS query for .onion"; dns.query; content:".onion"; nocase; endswith; classtype:policy-violation; priority:2; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN DNS query for .onion, source payload patterns for attacks against services behind this appliance; sid:2100070; rev:1;)
alert dns any any -> any any (msg:"CYPHORN DNS query to dynamic DNS provider"; dns.query; content:"duckdns.org"; nocase; endswith; classtype:policy-violation; priority:2; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN DNS query to dynamic DNS provider, source payload patterns for attacks against services behind this appliance; sid:2100071; rev:1;)
alert dns any any -> any any (msg:"CYPHORN DNS query to no-ip dynamic host"; dns.query; content:"ddns.net"; nocase; endswith; classtype:policy-violation; priority:2; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN DNS query to no-ip dynamic host, source payload patterns for attacks against services behind this appliance; sid:2100072; rev:1;)

# TLS identity. SNI is visible until Encrypted Client Hello is in use.
alert tls any any -> any any (msg:"CYPHORN TLS to Tor directory authority"; tls.sni; content:"torproject.org"; nocase; endswith; classtype:policy-violation; priority:2; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN TLS to Tor directory authority, source payload patterns for attacks against services behind this appliance; sid:2100080; rev:1;)
# A TLS session with no SNI at all, to a host that was never in a DNS answer,
# is how a lot of malware calls home. Alert only: some legitimate software
# connects to a bare IP.
alert tls any any -> any any (msg:"CYPHORN Expired certificate accepted by client"; tls_cert_expired; classtype:policy-violation; priority:2; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN Expired certificate accepted by client, source payload patterns for attacks against services behind this appliance; sid:2100081; rev:1;)

# =====================================================================
# 8. Protocol abuse and scanning at the TCP layer          [alert]
# =====================================================================
# The flag anomalies P1-001 detects, expressed as rules so they alert with a
# name rather than only incrementing a counter.

alert tcp any any -> any any (msg:"CYPHORN TCP NULL scan"; flags:0; classtype:attempted-recon; priority:2; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN TCP NULL scan, source payload patterns for attacks against services behind this appliance; sid:2100090; rev:1;)
alert tcp any any -> any any (msg:"CYPHORN TCP XMAS scan"; flags:FPU; classtype:attempted-recon; priority:2; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN TCP XMAS scan, source payload patterns for attacks against services behind this appliance; sid:2100091; rev:1;)
alert tcp any any -> any any (msg:"CYPHORN TCP SYN-FIN anomaly"; flags:SF; classtype:attempted-recon; priority:2; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN TCP SYN-FIN anomaly, source payload patterns for attacks against services behind this appliance; sid:2100092; rev:1;)

# A connection-rate rule was written here and removed before shipping.
#
#   alert tcp any any -> any any (... flags:S; threshold:type threshold,
#                                 track by_src, count 200, seconds 10; ...)
#
# It fired on the *first* SYN of the test capture, with one connection from
# one source against a count of 200. Whatever the threshold clause did there,
# it did not gate the alert, and a rule that fires two hundred times earlier
# than it claims is a rule that teaches its operator to ignore the log.
#
# Left out rather than tuned, because tuning a rule whose gating is not
# understood is how a ruleset fills with rules nobody trusts. P1-011 already
# counts resource-exhaustion floods in telemetry, which is where this signal
# actually lives today.

# =====================================================================
# 9. SMB and RDP exposure                                  [drop]
# =====================================================================
# There is no SMB or RDP dissector, so these match at the TCP layer: traffic
# to these ports crossing the WAN boundary at all is the finding. Stated
# plainly because a port match is weaker evidence than a parsed protocol.

# drop tcp any any -> any 445 (msg:"CYPHORN SMB crossing the WAN boundary"; flow:to_server; classtype:policy-violation; priority:1; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN SMB crossing the WAN boundary, source payload patterns for attacks against services behind this appliance; sid:2000100; rev:1;)
drop tcp any any -> any 3389 (msg:"CYPHORN RDP crossing the WAN boundary"; flow:to_server; classtype:policy-violation; priority:1; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN RDP crossing the WAN boundary, source payload patterns for attacks against services behind this appliance; sid:2000101; rev:1;)
drop tcp any any -> any 23 (msg:"CYPHORN Telnet crossing the WAN boundary"; flow:to_server; classtype:policy-violation; priority:1; metadata:owner cyphorn-engine, review_date 2026-09-15, rationale CYPHORN Telnet crossing the WAN boundary, source payload patterns for attacks against services behind this appliance; sid:2000102; rev:1;)

# =====================================================================
# What is deliberately not here
# =====================================================================
#
#   - No XSS rules. Detecting XSS without a regex means matching "<script",
#     which appears in legitimate pages and in every security article about
#     XSS. A rule that fires on an article about attacks is a rule that
#     teaches its operator to ignore it.
#
#   - No country policy. GeoIP is available (`geoip:` and country-policy.conf)
#     but which countries to refuse is a decision for whoever runs this
#     appliance, not a default someone else picks.
#
#   - No IP reputation. P4-001: the engine has no reputation dataset support.
#     GeoIP and ASN are not reputation, and using them as if they were is the
#     over-claim T-013 exists to catch.
#
#   - No HTTP/2 or HTTP/3 rules. There is no dissector for either. A rule
#     written with `http2` in it would parse and never match, which is worse
#     than no rule -- it is a coverage gap that looks like coverage.
# ==============================================================================
# CyphornIPS Phase 2.7 — TLS Certificate & Version Verification Rules
# Official Suricata 8.0.6 Semantics
# Safe Local Test Targets: 127.0.0.1 / 192.168.1.254
# ==============================================================================

# 1. Certificate NotBefore Exact / Range

# 2. Certificate NotBefore Greater-Than (Future / Modern NotBefore)

# 3. Certificate NotAfter Less-Than (Legacy / Expired NotAfter)

# 4. Certificate NotAfter Range

# 5. Certificate Expired (not_after < current time)

# 6. Certificate Currently Valid (not_before <= current time <= not_after)

# 7. Negotiated TLS Version 1.2

# 8. Negotiated TLS Version 1.3

# 9. SSL Record Version TLS 1.2

# 10. SSL Record Version Negation (!TLS 1.2)

# 11. Multi-keyword Rule: SNI + Valid Cert + Negotiated TLS 1.3

# 12. Multi-keyword Drop Rule: SNI + Expired Cert
