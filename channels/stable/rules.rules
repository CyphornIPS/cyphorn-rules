# Certificate hygiene.
#
# Every rule below names a property of the certificate or of the handshake it
# arrived in. None names a host, an authority, or a site. Point this at any
# network and it reports the same faults wherever they occur.

alert tls any any -> any any (msg:"CYPHORN CERT expired"; tls.cert_expired; classtype:protocol-command-decode; sid:9200001; rev:1;)
alert tls any any -> any any (msg:"CYPHORN CERT not yet valid"; tls.cert_not_yet_valid; classtype:protocol-command-decode; sid:9200002; rev:1;)
alert tls any any -> any any (msg:"CYPHORN CERT self-signed"; tls.cert_self_signed; classtype:bad-unknown; sid:9200003; rev:1;)
alert tls any any -> any any (msg:"CYPHORN CERT does not carry the requested name"; tls.cert_name_mismatch; classtype:bad-unknown; sid:9200004; rev:1;)
alert tls any any -> any any (msg:"CYPHORN CERT carries no names at all"; tls.cert_no_names; classtype:bad-unknown; sid:9200005; rev:1;)
alert tls any any -> any any (msg:"CYPHORN CERT chain incomplete"; tls.cert_chain_incomplete; classtype:protocol-command-decode; sid:9200006; rev:1;)
alert tls any any -> any any (msg:"CYPHORN CERT validity longer than any public CA issues"; tls.cert_long_validity; classtype:bad-unknown; sid:9200007; rev:1;)
alert tls any any -> any any (msg:"CYPHORN CERT validity window is impossible"; tls.cert_impossible_window; classtype:bad-unknown; sid:9200008; rev:1;)

# The shape an interception has: a certificate that is both unvouched-for and
# for somebody else's name. Two findings on one rule, so it is far narrower
# than either alone.
alert tls any any -> any any (msg:"CYPHORN CERT self-signed AND wrong name -- possible interception"; tls.cert_self_signed; tls.cert_name_mismatch; classtype:trojan-activity; sid:9200009; rev:1;)
alert tcp any any -> any 8080 (msg:"CYPHORN EXTERNAL RESPONSE TEST"; flow:established,to_client; content:"cloudflare"; sid:99000004; rev:1;)# HTTP event  rules
