# ==============================================================================
# CyphornIPS - Phase 2.6 Suricata 8.0.6 byte_test & byte_extract Test Rules
# Target: 192.168.1.254:80 (Harmless Local Test Rules)
# SIDs: 9200001 - 9200010
# ==============================================================================

# 1. 2-byte Big-Endian Comparison
alert tcp any any -> 192.168.1.254 80 (msg:"TEST ByteTest 2-Byte BigEndian"; byte_test:2,=,0x1234,0; sid:9200001; rev:1;)

# 2. 4-byte Little-Endian Comparison
alert tcp any any -> 192.168.1.254 80 (msg:"TEST ByteTest 4-Byte LittleEndian"; byte_test:4,=,0x12345678,0,little; sid:9200002; rev:1;)

# 3. Bitmask Comparison
alert tcp any any -> 192.168.1.254 80 (msg:"TEST ByteTest Bitmask 0x0F"; byte_test:1,=,0x05,0,bitmask 0x0F; sid:9200003; rev:1;)

# 4. Content Match with Relative byte_test
alert tcp any any -> 192.168.1.254 80 (msg:"TEST Content with Relative ByteTest"; content:"CMD:"; byte_test:2,=,0x0A0B,0,relative; sid:9200004; rev:1;)

# 5. byte_extract Variable Used in Subsequent byte_test
alert tcp any any -> 192.168.1.254 80 (msg:"TEST ByteExtract Variable In ByteTest"; content:"LEN:"; byte_extract:2,0,pkt_len,relative; byte_test:2,=,pkt_len,2,relative; sid:9200005; rev:1;)

# 6. byte_extract with Multiplier Used in Dynamic distance:var
alert tcp any any -> 192.168.1.254 80 (msg:"TEST ByteExtract Multiplier In Dynamic Distance"; content:"HEADER"; byte_extract:1,0,skip_cnt,relative,multiplier 2; content:"PAYLOAD"; distance:skip_cnt; within:10; sid:9200006; rev:1;)

# 7. ASCII String Mode (dec)
alert tcp any any -> 192.168.1.254 80 (msg:"TEST ByteTest String Dec Mode"; byte_test:4,=,1234,0,string,dec; sid:9200007; rev:1;)

# 8. Binary Payload with Embedded 0x00
alert tcp any any -> 192.168.1.254 80 (msg:"TEST Binary Hex and Embedded 0x00 ByteTest"; content:"|00 FF 00|"; byte_test:2,=,0x0001,0,relative; sid:9200008; rev:1;)

# 9. Multiple Byte Operations in Single Rule
alert tcp any any -> 192.168.1.254 80 (msg:"TEST Multiple Byte Operations In Sequence"; byte_test:1,=,0x01,0; byte_extract:2,1,sec_val; byte_test:2,=,sec_val,3; sid:9200009; rev:1;)

# 10. Negative Test: Content Match Hits but byte_test Fails (No Alert)
alert tcp any any -> 192.168.1.254 80 (msg:"TEST Content Hit but ByteTest Mismatch"; content:"TRIGGER_TAG"; byte_test:2,=,0xFFFF,0,relative; sid:9200010; rev:1;)

alert tcp any any -> any any (msg:"cmd exe Alert"; content:"cmd.exe"; nocase; sid:250811; rev:1;)
alert tcp any any -> any any (msg:"HTTP marker at offset 0"; content:"HTTP/1.1"; offset:0; sid:250812; rev:1;)
