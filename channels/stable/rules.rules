# Example rules for using the file handling and extraction functionality in Suricata.
#
# For storing files make sure you enable the "file" output.
# Also, make sure you read the comments that go with it in the suricata.yaml file.

# Alert on files with jpg or bmp extensions
alert http any any -> any any (msg:"FILEEXT JPG file claimed"; fileext:"jpg"; sid: 3347; rev:1;)
alert http any any -> any any (msg:"FILEEXT BMP file claimed"; fileext:"bmp"; sid: 3348; rev:1;)

# Store all files with jpg or pdf extension.
alert http any any -> any any (msg:"FILESTORE jpg"; flow:established,to_server; fileext:"jpg"; filestore; sid: 3349; rev:1;)
alert http any any -> any any (msg:"FILESTORE pdf"; flow:established,to_server; fileext:"pdf"; filestore; sid: 3350; rev:1;)

# Store all PDF files, regardless of their name.
alert http any any -> any any (msg:"FILEMAGIC pdf"; flow:established,to_server; filemagic:"PDF document"; filestore; sid: 3351; rev:1;)

# Same for JPEG's.
alert http any any -> any any (msg:"FILEMAGIC jpg(1)"; flow:established,to_server; filemagic:"JPEG image data"; filestore; sid: 3352; rev:1;)
alert http any any -> any any (msg:"FILEMAGIC jpg(2)"; flow:established,to_server; filemagic:"JFIF"; filestore; sid: 3353; rev:1;)

# Unually short file
alert http any any -> any any (msg:"FILEMAGIC short"; flow:established,to_server; filemagic:"very short file (no magic)"; filestore; sid: 3354; rev:1;)

# Simply store all files we encounter, no alerts.
alert http any any -> any any (msg:"FILE store all"; filestore; noalert; sid: 3355; rev:1;)

# Store all JPG files, don't alert.
alert http any any -> any any (msg:"FILE magic"; filemagic:"JFIF"; filestore; noalert; sid: 3356; rev:1;)
alert http any any -> any any (msg:"FILE magic"; filemagic:"GIF"; filestore; noalert; sid: 3357; rev:1;)
alert http any any -> any any (msg:"FILE magic"; filemagic:"PNG"; filestore; noalert; sid: 3358; rev:1;)

# Store all Windows executables
alert http any any -> any any (msg:"FILE magic -- windows"; flow:established,to_client; filemagic:"executable for MS Windows"; filestore; sid: 3359; rev:1;)

# Alert on PNG with 1x1 pixels (tracking)
alert http any any -> any any (msg:"FILE tracking PNG (1x1 pixel) (1)"; filemagic:"PNG image data, 1 x 1,"; sid: 3360; rev:1;)
alert http any any -> any any (msg:"FILE tracking PNG (1x1 pixel) (2)"; filemagic:"PNG image data, 1 x 1|00|"; sid: 3361; rev:1;)

# Alert on GIF with 1x1 pixels (tracking)
# The pattern matches on |00| which is the end of the magic buffer, this way we won't match on 1 x 128.
alert http any any -> any any (msg:"FILE tracking GIF (1x1 pixel)"; filemagic:"GIF image data, version 89a, 1 x 1|00|"; sid: 3362; rev:1;)

# Alert and store pdf attachment but not pdf file
alert http any any -> any any (msg:"FILE pdf claimed, but not pdf"; flow:established,to_client; fileext:"pdf"; filemagic:!"PDF document"; filestore; sid: 3363; rev:1;)

# Alert and store files over SMTP
alert smtp any any -> any any (msg:"File Found over SMTP and stored"; filestore; sid: 3364; rev:1;)

# Alert and store files from black list checksum: md5 or sha1 or sha256
alert http any any -> any any (msg:"Black list checksum match and extract MD5"; filemd5:fileextraction-chksum.list; filestore; sid: 3365; rev:1;)
alert http any any -> any any (msg:"Black list checksum match and extract SHA1"; filesha1:fileextraction-chksum.list; filestore; sid: 3366; rev:1;)
alert http any any -> any any (msg:"Black list checksum match and extract SHA256"; filesha256:fileextraction-chksum.list; filestore; sid: 3367; rev:1;)

# Alert and store files over FTP
alert ftp-data any any -> any any (msg:"File Found within FTP and stored"; filestore; filename:"password"; ftpdata_command:stor; sid: 3368; rev:1;)

# Alert and store files over SMB (with RUST activated)
alert smb any any -> any any (msg:"File Found over SMB and stored"; filestore; sid: 3369; rev:1;)

# Alert and store files over NFS (with RUST activated)
alert nfs any any -> any any (msg:"File found within NFS and stored"; filestore; sid: 3370; rev:1;)


