# ==============================================================================
# CyphornIPS Phase 2.7 — TLS Certificate & Version Verification Rules
# Official Suricata 8.0.6 Semantics
# Safe Local Test Targets: 127.0.0.1 / 192.168.1.254
# ==============================================================================

# 1. Certificate NotBefore Exact / Range
alert tls any any -> any any (msg:"TEST_TLS: Cert NotBefore in 2024"; tls_cert_notbefore:2024-01-01<>2024-12-31; sid:9200001; rev:1;)

# 2. Certificate NotBefore Greater-Than (Future / Modern NotBefore)
alert tls any any -> any any (msg:"TEST_TLS: Cert NotBefore after 2023"; tls_cert_notbefore:>2023-01-01; sid:9200002; rev:1;)

# 3. Certificate NotAfter Less-Than (Legacy / Expired NotAfter)
alert tls any any -> any any (msg:"TEST_TLS: Cert NotAfter before 2023"; tls_cert_notafter:<2023-01-01; sid:9200003; rev:1;)

# 4. Certificate NotAfter Range
alert tls any any -> any any (msg:"TEST_TLS: Cert NotAfter between 2025 and 2035"; tls_cert_notafter:2025-01-01<>2035-12-31; sid:9200004; rev:1;)

# 5. Certificate Expired (not_after < current time)
alert tls any any -> any any (msg:"TEST_TLS: Expired Certificate Detected"; tls_cert_expired; sid:9200005; rev:1;)

# 6. Certificate Currently Valid (not_before <= current time <= not_after)
alert tls any any -> any any (msg:"TEST_TLS: Valid Certificate Window Detected"; tls_cert_valid; sid:9200006; rev:1;)

# 7. Negotiated TLS Version 1.2
alert tls any any -> any any (msg:"TEST_TLS: Negotiated TLS 1.2"; tls.version:1.2; sid:9200007; rev:1;)

# 8. Negotiated TLS Version 1.3
alert tls any any -> any any (msg:"TEST_TLS: Negotiated TLS 1.3"; tls.version:1.3; sid:9200008; rev:1;)

# 9. SSL Record Version TLS 1.2
alert tls any any -> any any (msg:"TEST_TLS: SSL Record Version TLS 1.2"; ssl_version:tls1.2; sid:9200009; rev:1;)

# 10. SSL Record Version Negation (!TLS 1.2)
alert tls any any -> any any (msg:"TEST_TLS: SSL Record Version Not TLS 1.2"; ssl_version:!tls1.2; sid:9200010; rev:1;)

# 11. Multi-keyword Rule: SNI + Valid Cert + Negotiated TLS 1.3
alert tls any any -> any any (msg:"TEST_TLS: SNI local-test.internal with Valid TLS 1.3 Cert"; tls_sni:"local-test.internal"; tls_cert_valid; tls.version:1.3; sid:9200011; rev:1;)

# 12. Multi-keyword Drop Rule: SNI + Expired Cert
drop tls any any -> any any (msg:"TEST_TLS: Drop expired cert on bad-ssl.internal"; tls_sni:"bad-ssl.internal"; tls_cert_expired; sid:9200012; rev:1;)

