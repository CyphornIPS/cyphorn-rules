alert tcp any any -> any any (msg:"PASS followed by secret"; content:"PASS"; content:"secret"; distance:1; within:10; sid:250815; rev:1;)
alert tcp any any -> any any (msg:"Payload starts with PK"; content:"PK"; startswith; sid:250816; rev:1;)
alert tcp any any -> any any (msg:"PHP payload"; content:".php"; endswith; sid:250817; rev:1;)
alert tcp any any -> any any (msg:"UTF-16 marker"; content:"|ff fe|"; rawbytes; sid:250818; rev:1;)
alert tcp any any -> any any (msg:"Sensitive admin API"; content:"GET"; content:"/sensitive_admin_api"; fast_pattern; sid:250819; rev:1;)


